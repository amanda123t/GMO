# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, or local)
DATABASE_URL="postgresql://user:password@host:5432/gmo_ei?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/gmo_ei?schema=public"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# ─── Email (Magic Link / Nodemailer) ─────────────────────────────────────────
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="noreply@example.com"
EMAIL_SERVER_PASSWORD="your-smtp-password"
EMAIL_FROM="GMO EI Assessment <noreply@example.com>"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="EI Assessment – Gestão da Mudança"
