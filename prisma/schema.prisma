// ─── Prisma Schema ────────────────────────────────────────────────────────────
// GMO – EI Assessment for Change Management
// Architecture: multi-tenant, versioned questionnaire, waves, decoupled scoring

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// TENANT  (Organization / Client)
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  settings  Json     @default("{}") // theme, features flags, etc.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  waves       Wave[]
  assessments Assessment[]
  invitations Invitation[]

  @@map("tenants")
}

// ─────────────────────────────────────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  role          Role      @default(RESPONDENT)
  tenantId      String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant      Tenant?      @relation(fields: [tenantId], references: [id])
  accounts    Account[]
  sessions    Session[]
  assessments Assessment[]
  responses   Response[]

  @@map("users")
}

enum Role {
  SUPER_ADMIN  // platform owner
  TENANT_ADMIN // manages org, waves, questionnaires
  FACILITATOR  // views reports, manages respondents
  RESPONDENT   // takes assessments
}

// ─── NextAuth.js required models ──────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// QUESTIONNAIRE  (versioned)
// ─────────────────────────────────────────────────────────────────────────────

model QuestionnaireVersion {
  id          String   @id @default(cuid())
  version     Int      @default(1)
  name        String   // e.g. "EI-GMO v1.0"
  description String?  @db.Text
  isActive    Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dimensions  Dimension[]
  assessments Assessment[]

  @@unique([version])
  @@map("questionnaire_versions")
}

model Dimension {
  id                     String               @id @default(cuid())
  questionnaireVersionId String
  name                   String   // e.g. "Autoconsciência", "Autogestão", "Empatia", etc.
  description            String?  @db.Text
  order                  Int
  weight                 Float    @default(1.0) // for weighted scoring
  colorHex               String?  // UI colour per dimension

  questionnaireVersion QuestionnaireVersion @relation(fields: [questionnaireVersionId], references: [id], onDelete: Cascade)
  questions            Question[]
  scores               Score[]

  @@unique([questionnaireVersionId, order])
  @@map("dimensions")
}

model Question {
  id          String       @id @default(cuid())
  dimensionId String
  text        String       @db.Text
  helpText    String?      @db.Text
  order       Int
  type        QuestionType @default(LIKERT_5)
  isReversed  Boolean      @default(false) // reverse-scored items
  createdAt   DateTime     @default(now())

  dimension Dimension      @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  options   QuestionOption[]
  responses Response[]

  @@unique([dimensionId, order])
  @@map("questions")
}

enum QuestionType {
  LIKERT_5
  LIKERT_7
  MULTIPLE_CHOICE
  OPEN_TEXT
}

model QuestionOption {
  id         String @id @default(cuid())
  questionId String
  label      String  // "Discordo Totalmente"
  value      Int     // 1..5 or 1..7
  order      Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, order])
  @@map("question_options")
}

// ─────────────────────────────────────────────────────────────────────────────
// WAVE  (deployment cycle / cohort)
// ─────────────────────────────────────────────────────────────────────────────

model Wave {
  id          String     @id @default(cuid())
  tenantId    String
  name        String     // "Wave 1 – Diagnóstico Inicial Q1/2025"
  description String?    @db.Text
  startDate   DateTime
  endDate     DateTime
  status      WaveStatus @default(DRAFT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  assessments Assessment[]
  invitations Invitation[]

  @@map("waves")
}

enum WaveStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

// ─────────────────────────────────────────────────────────────────────────────
// ASSESSMENT  (one per respondent per wave)
// ─────────────────────────────────────────────────────────────────────────────

model Assessment {
  id                     String           @id @default(cuid())
  tenantId               String
  waveId                 String
  userId                 String
  questionnaireVersionId String
  status                 AssessmentStatus @default(PENDING)
  startedAt              DateTime?
  completedAt            DateTime?
  expiresAt              DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  tenant               Tenant               @relation(fields: [tenantId], references: [id])
  wave                 Wave                 @relation(fields: [waveId], references: [id])
  user                 User                 @relation(fields: [userId], references: [id])
  questionnaireVersion QuestionnaireVersion @relation(fields: [questionnaireVersionId], references: [id])
  responses            Response[]
  scores               Score[]

  @@unique([waveId, userId]) // one assessment per user per wave
  @@map("assessments")
}

enum AssessmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

// ─────────────────────────────────────────────────────────────────────────────
// RESPONSE  (one per question per assessment)
// ─────────────────────────────────────────────────────────────────────────────

model Response {
  id           String   @id @default(cuid())
  assessmentId String
  questionId   String
  userId       String
  numericValue Int?     // for LIKERT/MULTIPLE_CHOICE
  textValue    String?  @db.Text // for OPEN_TEXT
  answeredAt   DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([assessmentId, questionId])
  @@map("responses")
}

// ─────────────────────────────────────────────────────────────────────────────
// SCORE  (decoupled scoring engine output)
// ─────────────────────────────────────────────────────────────────────────────

model Score {
  id              String   @id @default(cuid())
  assessmentId    String
  dimensionId     String
  rawScore        Float    // sum of numeric responses
  normalizedScore Float    // 0–100 scale
  percentile      Float?   // relative to cohort (computed post-wave)
  computedAt      DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  dimension  Dimension  @relation(fields: [dimensionId], references: [id])

  @@unique([assessmentId, dimensionId])
  @@map("scores")
}

// ─────────────────────────────────────────────────────────────────────────────
// INVITATION  (email-based invite to a wave)
// ─────────────────────────────────────────────────────────────────────────────

model Invitation {
  id         String           @id @default(cuid())
  tenantId   String
  waveId     String
  email      String
  token      String           @unique @default(cuid())
  status     InvitationStatus @default(PENDING)
  sentAt     DateTime?
  acceptedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  wave   Wave   @relation(fields: [waveId], references: [id])

  @@unique([waveId, email])
  @@map("invitations")
}

enum InvitationStatus {
  PENDING
  SENT
  ACCEPTED
  EXPIRED
  CANCELLED
}
