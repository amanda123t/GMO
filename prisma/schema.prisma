// ─── Prisma Schema ────────────────────────────────────────────────────────────
// GMO – EI Assessment for Change Management
// Architecture: multi-tenant, versioned questionnaire, waves, decoupled scoring
//
// Hierarchy: Tenant → Project → Wave → Assessment
//
// Framework: IE aplicada à Execução de Mudança Organizacional (framework próprio)
// 6 dimensões oficiais:
//   SELF_AWARENESS | SELF_MANAGEMENT | MOTIVATION | EMPATHY | SOCIAL_SKILLS | ADAPTABILITY

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// TENANT  (Organization / Client)
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  settings  Json     @default("{}") // theme, feature flags, etc.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  projects    Project[]    // primary path: Tenant → Project → Wave
  waves       Wave[]       // denormalized back-relation (Wave.tenantId FK)
  assessments Assessment[] // denormalized back-relation (Assessment.tenantId FK)
  invitations Invitation[]

  @@map("tenants")
}

// ─────────────────────────────────────────────────────────────────────────────
// PROJECT  (Change initiative grouping waves)
// Sits between Tenant and Wave: one tenant can run multiple change projects.
// ─────────────────────────────────────────────────────────────────────────────

model Project {
  id          String        @id @default(cuid())
  tenantId    String
  name        String
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  waves  Wave[]

  @@map("projects")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

// ─────────────────────────────────────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  role          Role      @default(RESPONDENT)
  tenantId      String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant      Tenant?      @relation(fields: [tenantId], references: [id])
  accounts    Account[]
  sessions    Session[]
  assessments Assessment[]
  responses   Response[]

  @@map("users")
}

enum Role {
  SUPER_ADMIN  // platform owner
  TENANT_ADMIN // manages org, waves, questionnaires
  FACILITATOR  // views reports, manages respondents
  RESPONDENT   // takes assessments
}

// ─── NextAuth.js required models ──────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// QUESTIONNAIRE  (versioned, global — shared across tenants)
// ─────────────────────────────────────────────────────────────────────────────

model QuestionnaireVersion {
  id          String    @id @default(cuid())
  version     Int       @default(1)
  name        String    // e.g. "EI-GMO v1.0"
  description String?   @db.Text
  isActive    Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  dimensions Dimension[]
  waves      Wave[]      // questionnaireVersionId lives on Wave now

  @@unique([version])
  @@map("questionnaire_versions")
}

model Dimension {
  id                     String @id @default(cuid())
  questionnaireVersionId String
  // Stable machine-readable code (never changes after creation)
  // GMO framework codes: SELF_AWARENESS | SELF_MANAGEMENT | MOTIVATION |
  //                      EMPATHY | SOCIAL_SKILLS | ADAPTABILITY
  code                   String
  name                   String  @db.Text
  description            String? @db.Text
  order                  Int
  weight                 Float   @default(1.0) // for weighted scoring
  colorHex               String? // UI colour per dimension

  questionnaireVersion QuestionnaireVersion @relation(fields: [questionnaireVersionId], references: [id], onDelete: Cascade)
  questions            Question[]
  scores               Score[]

  @@unique([questionnaireVersionId, order])
  @@unique([questionnaireVersionId, code]) // code is unique within a version
  @@map("dimensions")
}

model Question {
  id          String       @id @default(cuid())
  dimensionId String
  text        String       @db.Text
  helpText    String?      @db.Text
  order       Int
  type        QuestionType @default(LIKERT_5)
  isReversed  Boolean      @default(false) // reverse-scored items
  createdAt   DateTime     @default(now())

  dimension Dimension        @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  options   QuestionOption[]
  responses Response[]

  @@unique([dimensionId, order])
  @@map("questions")
}

enum QuestionType {
  LIKERT_5
  LIKERT_7
  MULTIPLE_CHOICE
  OPEN_TEXT
}

model QuestionOption {
  id         String @id @default(cuid())
  questionId String
  label      String // "Discordo Totalmente"
  value      Int    // 1..5 or 1..7
  order      Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, order])
  @@map("question_options")
}

// ─────────────────────────────────────────────────────────────────────────────
// WAVE  (deployment cycle within a Project)
//
// questionnaireVersionId lives here so all respondents in a wave answer
// the same questionnaire version. Moving it to Assessment would allow
// inconsistent versions within a wave — which is wrong for this use case.
// ─────────────────────────────────────────────────────────────────────────────

model Wave {
  id                     String     @id @default(cuid())
  // tenantId denormalized for fast multi-tenant filtering without joins
  tenantId               String
  projectId              String
  questionnaireVersionId String
  name                   String     // "Wave 1 – Diagnóstico Inicial Q1/2025"
  description            String?    @db.Text
  startDate              DateTime
  endDate                DateTime
  status                 WaveStatus @default(DRAFT)
  // Hybrid auth: when true, anonymous token-based responses are accepted
  allowAnonymous         Boolean    @default(false)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  tenant               Tenant               @relation(fields: [tenantId], references: [id])
  project              Project              @relation(fields: [projectId], references: [id])
  questionnaireVersion QuestionnaireVersion @relation(fields: [questionnaireVersionId], references: [id])
  assessments          Assessment[]
  invitations          Invitation[]

  @@map("waves")
}

enum WaveStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

// ─────────────────────────────────────────────────────────────────────────────
// ASSESSMENT  (one per respondent per wave)
//
// Hybrid auth model:
//   - Authenticated: userId is set, anonymousToken is null
//                    respondentKey = "<waveId>_<userId>"
//   - Anonymous:     userId is null, anonymousToken is a unique UUID
//                    respondentKey = "<waveId>_<anonymousToken>"
//                    anonymousEmail optionally collected at end of survey
//
// respondentKey enforces one-assessment-per-respondent-per-wave at DB level.
// questionnaireVersionId is intentionally NOT here — it lives on Wave.
// ─────────────────────────────────────────────────────────────────────────────

model Assessment {
  id             String           @id @default(cuid())
  // tenantId denormalized for fast multi-tenant filtering without joins
  tenantId       String
  waveId         String
  userId         String?          // null for anonymous respondents
  anonymousToken String?          @unique // unique token for link-based access
  anonymousEmail String?          // optional, collected at end of anonymous survey
  // DB-level uniqueness: "<waveId>_<userId>" or "<waveId>_<anonymousToken>"
  respondentKey  String           @unique
  status         AssessmentStatus @default(PENDING)
  startedAt      DateTime?
  completedAt    DateTime?
  expiresAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  wave      Wave       @relation(fields: [waveId], references: [id])
  user      User?      @relation(fields: [userId], references: [id])
  responses Response[]
  scores    Score[]

  @@map("assessments")
}

enum AssessmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

// ─────────────────────────────────────────────────────────────────────────────
// RESPONSE  (one per question per assessment)
// ─────────────────────────────────────────────────────────────────────────────

model Response {
  id           String   @id @default(cuid())
  assessmentId String
  questionId   String
  userId       String?  // null for anonymous responses
  numericValue Int?     // for LIKERT / MULTIPLE_CHOICE
  textValue    String?  @db.Text // for OPEN_TEXT
  answeredAt   DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id])
  user       User?      @relation(fields: [userId], references: [id])

  @@unique([assessmentId, questionId])
  @@map("responses")
}

// ─────────────────────────────────────────────────────────────────────────────
// SCORE  (decoupled scoring engine output)
//
// Written by an external scoring function/worker — never computed inline.
// Percentile is ALWAYS internal: wave or tenant cohort, no external benchmark.
// ─────────────────────────────────────────────────────────────────────────────

model Score {
  id               String      @id @default(cuid())
  assessmentId     String
  dimensionId      String
  rawScore         Float       // sum of numericValue (applying isReversed)
  normalizedScore  Float       // 0–100 scale
  cohortPercentile Float?      // internal only — no external benchmark
  cohortScope      CohortScope @default(WAVE)
  computedAt       DateTime    @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  dimension  Dimension  @relation(fields: [dimensionId], references: [id])

  @@unique([assessmentId, dimensionId])
  @@map("scores")
}

// Defines the comparison group for cohortPercentile computation
enum CohortScope {
  WAVE   // ranked among respondents of the same wave
  TENANT // ranked among all respondents of the same tenant (cross-wave)
}

// ─────────────────────────────────────────────────────────────────────────────
// INVITATION  (email-based invite to a wave)
// ─────────────────────────────────────────────────────────────────────────────

model Invitation {
  id         String           @id @default(cuid())
  tenantId   String
  waveId     String
  email      String
  token      String           @unique @default(cuid())
  status     InvitationStatus @default(PENDING)
  sentAt     DateTime?
  acceptedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  wave   Wave   @relation(fields: [waveId], references: [id])

  @@unique([waveId, email])
  @@map("invitations")
}

enum InvitationStatus {
  PENDING
  SENT
  ACCEPTED
  EXPIRED
  CANCELLED
}
